# ============================================================
# CoreHealth Mobile - Environment Variables Template
# ============================================================
# Copy to .env (gitignored) and fill in values, then pass them at build time:
#   flutter run --dart-define=COREHEALTH_API_BASE_URL=https://api.corehealth.page/api \
#               --dart-define=GOOGLE_CLIENT_ID=...
#
# IMPORTANT: the app talks ONLY to the shared CoreHealth backend. All
# third-party secrets (AI keys, SePay, GHN, SMTP, Cloudinary, DB password)
# live server-side and must NEVER be placed in the client.
# ============================================================

# --- App Configuration ---
ENVIRONMENT=development

# --- Shared Backend (includes the /api prefix) ---
COREHEALTH_API_BASE_URL=https://api.corehealth.page/api

# --- Google Sign-In (public OAuth client id, safe in client) ---
GOOGLE_CLIENT_ID=

# --- Optional: Cloudflare Turnstile SITE key only (public; never the secret) ---
# TURNSTILE_SITE_KEY=
