# ============================================================
# CoreHealth Mobile - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# --- App Configuration ---
ENVIRONMENT=development

# --- JWT ---
JWT_SECRET=

# --- Google Auth ---
GOOGLE_CLIENT_ID=

# --- AI Services ---
GROQ_API_KEY=
BEEKNOEE_API_KEY=
GOLLM_API_KEY=

# --- YMove ---
YMOVE_API_KEY=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=

# --- SePay Payment ---
SEPAY_API_TOKEN=
SEPAY_WEBHOOK_API_KEY=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_ID=
SEPAY_ACCOUNT_NAME=

# --- GHN (Giao Hang Nhanh) ---
GHN_TOKEN=
GHN_SHOP_ID=
GHN_SHOP_PHONE=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Backend / API ---
COREHEALTH_API_BASE_URL=

# --- PostgreSQL ---
COREHEALTH_POSTGRES_HOST=
COREHEALTH_POSTGRES_DATABASE=corehealth
COREHEALTH_POSTGRES_USER=postgres
COREHEALTH_POSTGRES_PASSWORD=
COREHEALTH_POSTGRES_PORT=5432

# --- Gmail SMTP ---
SMTP_USERNAME=
SMTP_PASSWORD=
